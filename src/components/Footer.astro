---
---

<footer class="site-footer">
  <div class="container footer-container">
    <div class="footer-grid">
      <!-- Col 1: Brand & Origin -->
      <div class="footer-col brand-col">
        <a href="/" class="footer-logo-link">
          <img src="/assets/band_logo.png" alt="Possum Creek Pickers Logo" class="footer-logo" width="200" height="66" />
        </a>
        <p class="footer-tagline">
          Authentic bluegrass & acoustic picking born on the banks of Possum Creek in Chattanooga, TN.
        </p>
        <div class="footer-social">
          <a 
            href="https://www.instagram.com/possumcreekpickers" 
            target="_blank" 
            rel="noopener noreferrer"
            class="social-badge"
            aria-label="Instagram @possumcreekpickers"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
            </svg>
            <span>@possumcreekpickers</span>
          </a>
        </div>
      </div>

      <!-- Col 2: Navigation -->
      <div class="footer-col">
        <h4 class="footer-title">Navigation</h4>
        <ul class="footer-links">
          <li><a href="/">Home Page</a></li>
          <li><a href="/epk">Electronic Press Kit (EPK)</a></li>
          <li><a href="/epk#biography">Band Bio & Story</a></li>
          <li><a href="/epk#roster">Band Members</a></li>
          <li><a href="/epk#press-assets">Press Assets & Downloads</a></li>
        </ul>
      </div>

      <!-- Col 3: Lineup -->
      <div class="footer-col">
        <h4 class="footer-title">Band Lineup</h4>
        <ul class="lineup-list">
          <li>
            <strong>Elliott Brown</strong>
            <span>Guitar & Lead Vocals</span>
          </li>
          <li>
            <strong>Micah Courey</strong>
            <span>Mandolin & Backup Vocals</span>
          </li>
          <li>
            <strong>Kevin Taylor</strong>
            <span>Bass & Backup Vocals</span>
          </li>
        </ul>
      </div>

      <!-- Col 4: Booking & Contact -->
      <div class="footer-col">
        <h4 class="footer-title">Booking & Contact</h4>
        <p class="footer-text">
          Available for festivals, venues, private events, and weddings across Tennessee and the Southeast.
        </p>
        <div class="booking-meta">
          <span class="meta-label">Location:</span> Chattanooga, TN
        </div>
        <a href="mailto:booking@possumcreekpickers.com" class="btn btn-secondary btn-sm footer-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          Email Booking Inquiry
        </a>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {new Date().getFullYear()} Possum Creek Pickers. All Rights Reserved. Chattanooga, Tennessee.</p>
      <p class="credit">Built with Astro & Acoustic Soul.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #05080e;
    border-top: 1px solid rgba(245, 158, 11, 0.15);
    padding-top: 4rem;
    padding-bottom: 2rem;
    margin-top: auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1.2fr 1.2fr;
    gap: 2.5rem;
    margin-bottom: 3.5rem;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-logo {
    height: 48px;
    width: auto;
    object-fit: contain;
    margin-bottom: 0.5rem;
  }

  .footer-tagline {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .social-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--amber-glow);
    font-weight: 600;
    font-size: 0.9rem;
    transition: all 0.25s ease;
  }

  .social-badge:hover {
    background: linear-gradient(135deg, rgba(131, 58, 180, 0.2), rgba(253, 29, 29, 0.2));
    border-color: rgba(253, 29, 29, 0.4);
    color: #fff;
    transform: translateY(-2px);
  }

  .footer-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--amber-gold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-links a {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .footer-links a:hover {
    color: var(--amber-glow);
    padding-left: 4px;
  }

  .lineup-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .lineup-list li {
    display: flex;
    flex-direction: column;
    font-size: 0.95rem;
  }

  .lineup-list strong {
    color: var(--text-main);
  }

  .lineup-list span {
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .footer-text {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .booking-meta {
    font-size: 0.9rem;
    color: var(--text-light);
  }

  .meta-label {
    color: var(--amber-gold);
    font-weight: 600;
  }

  .footer-btn {
    align-self: flex-start;
    margin-top: 0.5rem;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  .credit {
    color: var(--amber-gold);
    opacity: 0.8;
  }

  @media (max-width: 992px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 0.5rem;
      text-align: center;
    }
  }
</style>
