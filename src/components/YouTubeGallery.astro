---
export interface VideoItem {
  id?: string;
  title: string;
  description: string;
  category: string;
  duration: string;
}

const placeholderVideos: VideoItem[] = [
  {
    title: "Possum Creek Jam (Live Acoustic Session)",
    description: "Original bluegrass pickin' live from Chattanooga, featuring Elliott on lead vocals and Micah on high lonesome mandolin solos.",
    category: "Live Session",
    duration: "4:12"
  },
  {
    title: "Tennessee Mountain Breakdown",
    description: "High-energy instrumental breakdown showcasing fast acoustic guitar flatpicking and deep bass groove from Kevin Taylor.",
    category: "Instrumental",
    duration: "3:45"
  },
  {
    title: "Banks of Possum Creek (Original)",
    description: "The song that started it all — inspired by late-night porch pickin' along the creek waters of Hamilton County, TN.",
    category: "Original Song",
    duration: "4:50"
  }
];
---

<section class="youtube-section" id="videos">
  <div class="container">
    <div class="section-header text-center">
      <span class="badge badge-amber">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="red" stroke="red"><path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.56 49.56 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><path d="m10 15 5-3-5-3z" fill="white" stroke="white"/></svg>
        YouTube Channel & Performances
      </span>
      <h2 class="section-title gradient-text">Live Pickin' & Performances</h2>
      <p class="section-subtitle">
        We are getting ready to launch our official Possum Creek Pickers YouTube channel with live concert recordings, porch jams, and acoustic sessions!
      </p>
    </div>

    <!-- YouTube Channel Announcement Banner -->
    <div class="glass-card yt-banner">
      <div class="yt-banner-content">
        <div class="yt-icon-wrapper">
          <svg class="yt-logo-svg" xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="#FF0000">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
        </div>
        <div class="yt-banner-text">
          <h3>Official Band YouTube Channel Launching Soon</h3>
          <p>Full live performance videos, acoustic sessions, and behind-the-scenes picking will be embedded right here.</p>
        </div>
      </div>
      <a 
        href="https://www.youtube.com/@possumcreekpickers" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="btn btn-secondary btn-sm yt-sub-btn"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
        Notify Me On YouTube
      </a>
    </div>

    <!-- Video Showcase Grid -->
    <div class="video-grid">
      {placeholderVideos.map((video, index) => (
        <div class="glass-card video-card">
          <div class="video-thumbnail-container">
            <img 
              src="/assets/band_live.JPEG" 
              alt={video.title} 
              class="video-thumb-img" 
              loading="lazy"
            />
            <div class="thumbnail-overlay">
              <span class="video-category-badge">{video.category}</span>
              <span class="video-duration">{video.duration}</span>
              <button class="play-btn" aria-label={`Play ${video.title}`}>
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><polygon points="6 3 20 12 6 21 6 3"/></svg>
              </button>
            </div>
          </div>

          <div class="video-card-body">
            <h3 class="video-title">{video.title}</h3>
            <p class="video-desc">{video.description}</p>
            <div class="video-footer">
              <span class="video-location">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                Chattanooga, TN
              </span>
              <span class="video-status">Preview Track #{index + 1}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .youtube-section {
    padding-top: 5rem;
    padding-bottom: 5rem;
  }

  .text-center {
    text-align: center;
  }

  .section-header {
    max-width: 720px;
    margin: 0 auto 3rem auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .section-title {
    font-size: 2.5rem;
    font-weight: 800;
  }

  .section-subtitle {
    color: var(--text-muted);
    font-size: 1.1rem;
    line-height: 1.6;
  }

  .yt-banner {
    padding: 1.75rem 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 3rem;
    background: linear-gradient(135deg, rgba(239, 68, 68, 0.08), rgba(15, 23, 42, 0.8));
    border-color: rgba(239, 68, 68, 0.25);
  }

  .yt-banner-content {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .yt-icon-wrapper {
    background: rgba(255, 0, 0, 0.1);
    padding: 0.75rem;
    border-radius: var(--radius-md);
    border: 1px solid rgba(255, 0, 0, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .yt-banner-text h3 {
    font-size: 1.2rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.25rem;
  }

  .yt-banner-text p {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .yt-sub-btn {
    white-space: nowrap;
    border-color: rgba(239, 68, 68, 0.4);
    color: #fca5a5;
  }

  .yt-sub-btn:hover {
    background: rgba(239, 68, 68, 0.2);
    color: #fff;
  }

  .video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }

  .video-card {
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .video-thumbnail-container {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #000;
  }

  .video-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
    transition: transform 0.4s ease, opacity 0.4s ease;
  }

  .video-card:hover .video-thumb-img {
    transform: scale(1.05);
    opacity: 0.95;
  }

  .thumbnail-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, transparent 60%);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  .video-category-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: rgba(15, 23, 42, 0.85);
    color: var(--amber-glow);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(245, 158, 11, 0.3);
    backdrop-filter: blur(4px);
  }

  .video-duration {
    position: absolute;
    bottom: 1rem;
    right: 1rem;
    background: rgba(0, 0, 0, 0.8);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  .play-btn {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-full);
    background: rgba(245, 158, 11, 0.9);
    color: #0d1117;
    border: 2px solid #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-left: 4px;
    cursor: pointer;
    box-shadow: 0 0 25px rgba(245, 158, 11, 0.6);
    transition: transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275), background 0.25s ease;
  }

  .video-card:hover .play-btn {
    transform: scale(1.15);
    background: var(--amber-glow);
    box-shadow: 0 0 35px rgba(251, 191, 36, 0.8);
  }

  .video-card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex-grow: 1;
  }

  .video-title {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-main);
    line-height: 1.3;
  }

  .video-desc {
    color: var(--text-muted);
    font-size: 0.925rem;
    line-height: 1.5;
  }

  .video-footer {
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.825rem;
    color: var(--text-muted);
  }

  .video-location {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--amber-gold);
  }

  @media (max-width: 768px) {
    .yt-banner {
      flex-direction: column;
      align-items: flex-start;
    }
    .yt-sub-btn {
      width: 100%;
    }
  }
</style>
