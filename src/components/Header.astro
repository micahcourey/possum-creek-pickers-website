---
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/\/$/, "");
---

<header class="site-header">
  <div class="container header-container">
    <a href="/" class="brand-link" aria-label="Possum Creek Pickers Home">
      <img 
        src="/assets/band_logo.png?v=possums3" 
        alt="Possum Creek Pickers Logo" 
        class="brand-logo"
        width="180" 
        height="60"
      />
    </a>

    <nav class="nav-desktop" aria-label="Main Navigation">
      <a 
        href="/" 
        class={`nav-link ${currentPath === "" ? "active" : ""}`}
      >
        Home
      </a>
      <a 
        href="/#shows" 
        class="nav-link"
      >
        Tour
      </a>
      <a 
        href="/epk" 
        class={`nav-link ${currentPath === "/epk" ? "active" : ""}`}
      >
        EPK <span class="nav-badge">Press Kit</span>
      </a>
    </nav>

    <div class="header-actions">
      <a 
        href="https://www.instagram.com/possumcreekpickers" 
        target="_blank" 
        rel="noopener noreferrer"
        class="btn btn-instagram btn-sm"
        aria-label="Follow Possum Creek Pickers on Instagram"
      >
        <svg class="instagram-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
          <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
        </svg>
        <span>Instagram</span>
      </a>

      <a 
        href="https://www.youtube.com/@PossumCreekPickers" 
        target="_blank" 
        rel="noopener noreferrer"
        class="btn btn-secondary btn-sm yt-header-badge"
        aria-label="Subscribe to Possum Creek Pickers on YouTube"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
        </svg>
        <span>YouTube</span>
      </a>

      <button id="mobile-menu-toggle" class="mobile-toggle" aria-label="Toggle navigation menu" aria-expanded="false">
        <svg class="icon-menu" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="4" x2="20" y1="12" y2="12"></line>
          <line x1="4" x2="20" y1="6" y2="6"></line>
          <line x1="4" x2="20" y1="18" y2="18"></line>
        </svg>
        <svg class="icon-close" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none;">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-drawer" class="mobile-drawer">
    <nav class="nav-mobile">
      <a href="/" class={`mobile-nav-link ${currentPath === "" ? "active" : ""}`}>Home</a>
      <a href="/#shows" class="mobile-nav-link">Tour Dates</a>
      <a href="/epk" class={`mobile-nav-link ${currentPath === "/epk" ? "active" : ""}`}>Electronic Press Kit (EPK)</a>
      <div class="mobile-social-wrap">
        <a 
          href="https://www.instagram.com/possumcreekpickers" 
          target="_blank" 
          rel="noopener noreferrer"
          class="btn btn-instagram w-full"
        >
          <svg class="instagram-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
          </svg>
          <span>Instagram</span>
        </a>

        <a 
          href="https://www.youtube.com/@PossumCreekPickers" 
          target="_blank" 
          rel="noopener noreferrer"
          class="btn btn-secondary w-full"
          style="margin-top: 0.5rem;"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
          <span>YouTube Channel</span>
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(246, 243, 235, 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(27, 67, 44, 0.15);
    transition: all 0.3s ease;
  }

  .header-container {
    display: flex;
    align-items: center;
    height: 80px;
    padding-left: 1.25rem;
    padding-right: 1.25rem;
    max-width: 1500px;
  }

  .brand-link {
    display: flex;
    align-items: center;
    margin-right: 2.5rem;
    transition: transform 0.2s ease;
  }

  .brand-link:hover {
    transform: scale(1.03);
  }

  .brand-logo {
    height: 52px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 2px 6px rgba(27, 67, 44, 0.15));
  }

  .nav-desktop {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .header-actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .nav-link {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-muted);
    position: relative;
    padding: 0.5rem 0;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nav-link:hover {
    color: var(--forest-green);
  }

  .nav-link.active {
    color: var(--forest-green);
    font-weight: 800;
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--forest-green), var(--wood-mahogany));
    border-radius: var(--radius-full);
    box-shadow: 0 0 8px rgba(27, 67, 44, 0.3);
  }

  .nav-badge {
    font-size: 0.7rem;
    background: rgba(27, 67, 44, 0.1);
    color: var(--forest-green);
    padding: 2px 6px;
    border-radius: 4px;
    border: 1px solid rgba(27, 67, 44, 0.25);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .mobile-toggle {
    display: none;
    background: transparent;
    border: 1px solid rgba(27, 67, 44, 0.25);
    color: var(--forest-green);
    padding: 0.5rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .mobile-toggle:hover {
    border-color: var(--forest-green);
    background: rgba(27, 67, 44, 0.08);
  }

  .mobile-drawer {
    display: none;
    background: rgba(242, 238, 229, 0.98);
    border-bottom: 1px solid var(--border-glass);
    padding: 1.5rem;
  }

  .mobile-drawer.open {
    display: block;
    animation: slideDown 0.25s ease-out;
  }

  .nav-mobile {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .mobile-nav-link {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-muted);
    padding: 0.5rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .mobile-nav-link.active, .mobile-nav-link:hover {
    color: var(--amber-glow);
  }

  .mobile-social-wrap {
    margin-top: 1rem;
  }

  .w-full {
    width: 100%;
  }

  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 768px) {
    .nav-desktop {
      display: none;
    }
    .mobile-toggle {
      display: flex;
    }
    .header-actions {
      gap: 0.5rem;
    }
    .header-actions .btn span {
      display: none;
    }
    .header-actions .btn {
      padding: 0.5rem 0.6rem;
      gap: 0;
    }
  }
</style>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const drawer = document.getElementById('mobile-drawer');
  const iconMenu = toggleBtn?.querySelector('.icon-menu') as HTMLElement;
  const iconClose = toggleBtn?.querySelector('.icon-close') as HTMLElement;

  toggleBtn?.addEventListener('click', () => {
    const isOpen = drawer?.classList.toggle('open');
    toggleBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    if (iconMenu && iconClose) {
      iconMenu.style.display = isOpen ? 'none' : 'block';
      iconClose.style.display = isOpen ? 'block' : 'none';
    }
  });
</script>
