---
import Layout from '../layouts/Layout.astro';
import YouTubeGallery from '../components/YouTubeGallery.astro';
import BandMemberCard from '../components/BandMemberCard.astro';
import TourDates from '../components/TourDates.astro';
---

<Layout title="Home">
  <!-- HERO SECTION -->
  <section class="hero-section">
    <div class="hero-bg-wrapper">
      <img 
        src="/assets/possum_creek.webp" 
        alt="Possum Creek - Soddy Daisy, Tennessee" 
        class="hero-bg-img"
        fetchpriority="high"
        loading="eager"
        width="1600"
        height="1200"
      />
      <div class="hero-overlay"></div>
    </div>

    <div class="container hero-container">
      <div class="hero-content">
        <!-- Dual Badges requested by user -->
        <div class="hero-badges">
          <div class="badge badge-burgundy animate-glow">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
            High-energy bluegrass and acoustic grooves
          </div>

          <div class="badge badge-earth">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            Chattanooga, TN
          </div>
        </div>

        <div class="hero-logo-box">
          <img 
            src="/assets/band_logo.png?v=possums3" 
            alt="Possum Creek Pickers" 
            class="hero-logo-img"
            width="420"
            height="140"
          />
        </div>

        <h1 class="hero-title">
          Authentic Picking Born on the Banks of <span class="gradient-text-burgundy">Possum Creek</span>
        </h1>

        <p class="hero-subtitle">
          High-energy bluegrass flatpicking, soaring mandolin leads, and driving acoustic bass lines from Chattanooga, Tennessee.
        </p>

        <div class="hero-actions">
          <a href="/epk" class="btn btn-burgundy">
            Explore Press Kit (EPK)
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
          
          <a href="#videos" class="btn btn-secondary">
            Watch Performances
          </a>

          <a 
            href="https://www.instagram.com/possumcreekpickers" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn btn-instagram"
          >
            <svg class="instagram-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
            </svg>
            @possumcreekpickers
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ORIGIN & STORY SECTION -->
  <section class="section story-section" id="origin">
    <div class="container">
      <div class="story-grid">
        <div class="story-image-wrap glass-card">
          <img 
            src="/assets/band_photo_2026_landscape.JPG" 
            alt="Possum Creek Pickers band photo" 
            class="story-img"
          />
          <div class="image-caption-bar">
            <span>Possum Creek Pickers Live in Action</span>
            <span class="location-badge">Chattanooga, TN</span>
          </div>
        </div>

        <div class="story-content">
          <span class="badge badge-amber">Our Story & Roots</span>
          <h2 class="section-heading gradient-text">Jamming on the Banks of Possum Creek</h2>
          
          <p class="story-text">
            The <strong>Possum Creek Pickers</strong> came to fruition on the banks of Possum Creek in Soddy Daisy following the unexpected loss of a close friend. Childhood friends Elliott Brown and Micah Courey committed to playing bluegrass regularly, turning fire pit jams along the creek into a neighborhood institution.
          </p>
          
          <p class="story-text">
            Joined at the Tuesday Night Bluegrass Jam at The Barrelhouse Ballroom by Chattanooga bassist Kevin Taylor, Possum Creek Pickers deliver high-energy bluegrass that effortlessly blends elements of blues and reggae, creating a signature acoustic sound uniquely their own.
          </p>

          <div class="origin-highlights">
            <div class="highlight-item">
              <div class="highlight-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M8 12h8"/><path d="M12 8v8"/></svg>
              </div>
              <div>
                <h4>High-Lonesome Groove</h4>
                <p>High-energy bluegrass infused with subtle blues and reggae feel</p>
              </div>
            </div>

            <div class="highlight-item">
              <div class="highlight-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <div>
                <h4>Scenic City Sound</h4>
                <p>Anchored in the vibrant Chattanooga bluegrass jam community</p>
              </div>
            </div>
          </div>

          <div class="story-cta">
            <a href="/epk" class="btn btn-primary btn-sm">Read Full EPK Biography</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- BAND ROSTER OVERVIEW -->
  <section class="section roster-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="badge badge-amber">The Musicians</span>
        <h2 class="section-title gradient-text">Meet The Pickers</h2>
        <p class="section-subtitle">Three distinct acoustic voices coming together in harmony.</p>
      </div>

      <div class="roster-grid">
        <BandMemberCard 
          name="Elliott Brown"
          role="Lead Vocals & Guitar"
          instrument="Acoustic Guitar"
          bio="Driving the band rhythm and soaring vocal leads, Elliott brings heart and soul to every melody."
          iconType="guitar"
          photoSrc="/assets/elliott_crop.webp?v=2026"
        />

        <BandMemberCard 
          name="Micah Courey"
          role="Mandolin & Backup Vocals"
          instrument="Mandolin"
          bio="Crafting chop rhythms and blistering lead runs that give Possum Creek Pickers its signature high lonesome sparkle."
          iconType="mandolin"
          photoSrc="/assets/micah_crop.webp?v=2026"
        />

        <BandMemberCard 
          name="Kevin Taylor"
          role="Bass & Backup Vocals"
          instrument="Upright Bass"
          bio="Laying down the deep acoustic foundation and driving rhythm pulse that keeps audiences stomping their feet."
          iconType="bass"
          photoSrc="/assets/kevin_crop.webp?v=2026"
        />
      </div>
    </div>
  </section>

  <!-- YOUTUBE VIDEO SECTION -->
  <YouTubeGallery />

  <!-- TOUR DATES SECTION -->
  <TourDates />

  <!-- INSTAGRAM CALLOUT BANNER -->
  <section class="section insta-banner-section">
    <div class="container">
      <div class="glass-card insta-card">
        <div class="insta-content">
          <div class="insta-icon-badge">
            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
            </svg>
          </div>
          <div>
            <h2 class="insta-title">Follow Our Possum Creek Journeys</h2>
            <p class="insta-subtitle">Get behind-the-scenes rehearsal clips, show announcements, and porch jams on Instagram.</p>
            <p class="insta-handle"><strong>@possumcreekpickers</strong></p>
          </div>
        </div>

        <a 
          href="https://www.instagram.com/possumcreekpickers" 
          target="_blank" 
          rel="noopener noreferrer"
          class="btn btn-instagram"
        >
          Follow @possumcreekpickers
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero Section */
  .hero-section {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: center;
    padding-top: 4rem;
    padding-bottom: 4rem;
    overflow: hidden;
  }

  .hero-bg-wrapper {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 65%, rgba(246, 243, 235, 0.92) 100%);
  }

  .hero-container {
    position: relative;
    z-index: 2;
  }

  .hero-content {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    padding: 2.75rem 2.25rem;
    background: rgba(255, 253, 248, 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(27, 67, 44, 0.2);
    border-radius: var(--radius-lg);
    box-shadow: 0 16px 45px -10px rgba(27, 67, 44, 0.15), 0 4px 15px rgba(0, 0, 0, 0.05);
  }

  .hero-badges {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .hero-logo-box {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .hero-logo-img {
    max-width: 380px;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 4px 15px rgba(27, 67, 44, 0.2));
  }

  .hero-title {
    font-size: 3.25rem;
    font-weight: 900;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--text-main);
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--text-muted);
    max-width: 680px;
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  .hero-quick-lineup {
    margin-top: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    flex-wrap: wrap;
    justify-content: center;
    background: rgba(255, 253, 248, 0.9);
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-glass);
    backdrop-filter: blur(12px);
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .lineup-item strong {
    color: var(--forest-green);
  }

  .lineup-divider {
    color: rgba(27, 67, 44, 0.4);
  }

  /* Story Section */
  .story-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  .story-image-wrap {
    overflow: hidden;
    position: relative;
    aspect-ratio: 4 / 3;
  }

  .story-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .story-image-wrap:hover .story-img {
    transform: scale(1.04);
  }

  .image-caption-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: rgba(246, 243, 235, 0.92);
    backdrop-filter: blur(8px);
    padding: 0.75rem 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.875rem;
    color: var(--text-main);
    border-top: 1px solid var(--border-glass);
  }

  .location-badge {
    color: var(--forest-green);
    font-weight: 700;
  }

  .story-content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .section-heading {
    font-size: 2.4rem;
    font-weight: 800;
  }

  .story-text {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .story-text strong {
    color: var(--text-main);
  }

  .origin-highlights {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin-top: 0.5rem;
  }

  .highlight-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    background: rgba(27, 67, 44, 0.05);
    padding: 1rem;
    border-radius: var(--radius-md);
    border: 1px solid rgba(27, 67, 44, 0.12);
  }

  .highlight-icon {
    background: rgba(27, 67, 44, 0.12);
    color: var(--forest-green);
    padding: 0.5rem;
    border-radius: var(--radius-sm);
    display: flex;
  }

  .highlight-item h4 {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 0.2rem;
  }

  .highlight-item p {
    font-size: 0.825rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .story-cta {
    margin-top: 0.5rem;
  }

  /* Roster Section */
  .roster-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 3rem;
  }

  /* Tour Coming Soon Card */
  .tour-coming-card {
    padding: 3.5rem;
    background: linear-gradient(135deg, rgba(255, 253, 248, 0.95), rgba(238, 233, 220, 0.9));
  }

  .tour-subtitle {
    color: var(--text-muted);
    font-size: 1.15rem;
    margin-top: 0.75rem;
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
  }

  .tour-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 2.5rem;
    margin-top: 3rem;
    align-items: center;
  }

  .tour-info-box {
    background: rgba(27, 67, 44, 0.04);
    border: 1px solid rgba(27, 67, 44, 0.15);
    border-radius: var(--radius-md);
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .info-badge-icon {
    background: rgba(27, 67, 44, 0.12);
    color: var(--forest-green);
    width: 56px;
    height: 56px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(27, 67, 44, 0.2);
  }

  .tour-info-box h3 {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--text-main);
  }

  .tour-info-box p {
    color: var(--text-muted);
    font-size: 1.025rem;
    line-height: 1.6;
  }

  .tour-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  .tour-social-box {
    background: linear-gradient(135deg, rgba(27, 67, 44, 0.05), rgba(156, 36, 53, 0.04));
    border: 1px solid rgba(27, 67, 44, 0.18);
    border-radius: var(--radius-md);
    padding: 2.25rem;
    height: 100%;
    display: flex;
    align-items: center;
  }

  .social-box-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
  }

  .insta-big-icon {
    color: var(--forest-green);
  }

  .social-box-inner h4 {
    font-size: 1.25rem;
    font-weight: 800;
  }

  .social-box-inner p {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  /* Instagram Banner */
  .insta-card {
    padding: 3rem 3.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    background: linear-gradient(135deg, rgba(27, 67, 44, 0.06), rgba(156, 36, 53, 0.04), rgba(255, 253, 248, 0.95));
    border-color: rgba(27, 67, 44, 0.2);
  }

  .insta-content {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .insta-icon-badge {
    background: linear-gradient(135deg, var(--forest-green), var(--forest-mid));
    padding: 1.25rem;
    border-radius: var(--radius-md);
    color: #fff;
    box-shadow: 0 6px 20px rgba(27, 67, 44, 0.2);
  }

  .insta-title {
    font-size: 1.75rem;
    font-weight: 800;
    margin-bottom: 0.25rem;
  }

  .insta-subtitle {
    color: var(--text-muted);
    font-size: 1.05rem;
    margin-bottom: 0.3rem;
  }

  .insta-handle {
    color: var(--forest-green);
    font-size: 1.1rem;
  }

  /* Responsiveness */
  @media (max-width: 992px) {
    .hero-title {
      font-size: 2.5rem;
    }
    .story-grid {
      grid-template-columns: 1fr;
    }
    .roster-grid {
      grid-template-columns: 1fr;
    }
    .tour-grid {
      grid-template-columns: 1fr;
    }
    .insta-card {
      flex-direction: column;
      text-align: center;
      padding: 2.5rem 1.5rem;
    }
    .insta-content {
      flex-direction: column;
    }
  }

  @media (max-width: 640px) {
    .hero-title {
      font-size: 2rem;
    }
    .tour-coming-card {
      padding: 1.75rem;
    }
    .origin-highlights {
      grid-template-columns: 1fr;
    }
  }
</style>
