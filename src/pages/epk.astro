---
import Layout from '../layouts/Layout.astro';
import YouTubeGallery from '../components/YouTubeGallery.astro';
import BandMemberCard from '../components/BandMemberCard.astro';
---

<Layout 
  title="Electronic Press Kit (EPK)"
  description="Official Electronic Press Kit (EPK) for Possum Creek Pickers. Bio, photos, logo downloads, line-up, tech rider, and booking information for press and venues."
>
  <!-- EPK HERO HEADER -->
  <section class="epk-hero">
    <div class="container">
      <div class="epk-header-card glass-card">
        <div class="epk-header-top">
          <div class="epk-title-area">
            <span class="badge badge-amber">Official Press Kit & Media Resources</span>
            <h1 class="epk-main-title gradient-text-gold">Possum Creek Pickers</h1>
            <p class="epk-tagline">Bluegrass & Acoustic Band • Chattanooga, Tennessee</p>
          </div>

          <a 
            href="https://www.instagram.com/possumcreekpickers" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn btn-instagram"
          >
            <svg class="instagram-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
            </svg>
            @possumcreekpickers
          </a>
        </div>

        <div class="epk-quick-stats">
          <div class="stat-box">
            <span class="stat-label">Origin</span>
            <span class="stat-value">Chattanooga, TN</span>
          </div>
          <div class="stat-box">
            <span class="stat-label">Genre</span>
            <span class="stat-value">Bluegrass / Acoustic</span>
          </div>
          <div class="stat-box">
            <span class="stat-label">Active Since</span>
            <span class="stat-value">2026</span>
          </div>
          <div class="stat-box">
            <span class="stat-label">Members</span>
            <span class="stat-value">3 Piece Lineup</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- BIOGRAPHY SECTION -->
  <section class="section bio-section" id="biography">
    <div class="container">
      <div class="bio-wrapper glass-card">
        <div class="bio-header">
          <span class="badge badge-amber">Official Bio</span>
          <h2 class="section-title gradient-text">Band Biography</h2>
        </div>

        <div class="bio-content-grid">
          <div class="bio-text-column">
            <h3 class="bio-subtitle">Born on the Banks of Possum Creek</h3>
            <p class="bio-p lead">
              The <strong>Possum Creek Pickers</strong> came to fruition on the banks of Possum Creek in Soddy Daisy following the unexpected loss of a close friend. Childhood friends Elliott Brown and Micah Courey had played music together since elementary school, and that tragic moment brought a clear realization: tomorrow is never guaranteed. Looking to fill a void that only music could heal, they committed to playing bluegrass regularly to keep their connection strong.
            </p>
            
            <p class="bio-p">
              Before long, Micah made the switch from guitar to mandolin, seamlessly adapting his decades of musical experience to the new instrument. What started as fire pit jams with friends along the creek quickly grew into a neighborhood institution.
            </p>

            <p class="bio-p">
              The final piece fell into place at the Tuesday Night Bluegrass Jam at The Barrelhouse Ballroom in downtown Chattanooga, where they met Kevin Taylor. The instant connection was undeniable. A Chattanooga native skilled on both guitar and electric bass, Kevin soon joined as the band's bassist and recently added an upright bass to his setup to help fully round out the signature Possum Creek Pickers bluegrass sound.
            </p>

            <p class="bio-p">
              Today, Possum Creek Pickers deliver high-energy bluegrass that effortlessly blends elements of blues and reggae, creating a signature acoustic sound uniquely their own.
            </p>
          </div>

          <div class="bio-sidebar-column">
            <div class="photo-card glass-card">
              <img 
                src="/assets/band_photo_2026_portrait.JPG" 
                alt="Possum Creek Pickers band portrait photo" 
                class="epk-photo-img"
              />
              <div class="photo-info">
                <span class="photo-title">Official Band Photo (Portrait)</span>
                <a href="/assets/band_photo_2026_portrait.JPG" download="possum_creek_pickers_portrait.JPG" class="btn btn-secondary btn-sm photo-download-btn">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                  Download Hi-Res Photo
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- BAND ROSTER & LINEUP -->
  <section class="section roster-section" id="roster">
    <div class="container">
      <div class="section-header text-center">
        <span class="badge badge-amber">Official Lineup</span>
        <h2 class="section-title gradient-text">Band Roster</h2>
        <p class="section-subtitle">Meet the musicians of Possum Creek Pickers.</p>
      </div>

      <div class="roster-grid">
        <BandMemberCard 
          name="Elliott Brown"
          role="Lead Vocals & Guitar"
          instrument="Acoustic Guitar"
          bio="Elliott leads the band's vocal melodies and rhythmic acoustic engine with powerful flatpicking and genuine storytelling."
          iconType="guitar"
          photoSrc="/assets/elliott_crop.jpg?v=2026"
        />

        <BandMemberCard 
          name="Micah Courey"
          role="Mandolin & Backup Vocals"
          instrument="Mandolin"
          bio="Micah delivers intricate mandolin chops, lightning lead runs, and tight harmony backing vocals."
          iconType="mandolin"
          photoSrc="/assets/micah_crop.jpg?v=2026"
        />

        <BandMemberCard 
          name="Kevin Taylor"
          role="Bass & Backup Vocals"
          instrument="Bass"
          bio="Kevin grounds the band with deep acoustic bass grooves and solid vocal support that drives the rhythmic engine."
          iconType="bass"
          photoSrc="/assets/kevin_crop.jpg?v=2026"
        />
      </div>
    </div>
  </section>

  <!-- PRESS ASSETS & PROMO MEDIA -->
  <section class="section assets-section" id="press-assets">
    <div class="container">
      <div class="section-header text-center">
        <span class="badge badge-amber">Promotional Kit</span>
        <h2 class="section-title gradient-text">Hi-Res Press Assets</h2>
        <p class="section-subtitle">Official logos and high-resolution band imagery for venue flyers, posters, and press coverage.</p>
      </div>

      <div class="assets-grid">
        <!-- Logo Asset Card -->
        <div class="glass-card asset-card">
          <div class="asset-preview logo-preview">
            <img src="/assets/band_logo.png?v=possums3" alt="Possum Creek Pickers Official Logo" class="asset-img-logo" />
          </div>
          <div class="asset-details">
            <h3 class="asset-name">Official Band Logo</h3>
            <p class="asset-meta">PNG Format • Transparent Background • High Resolution</p>
            <div class="asset-actions">
              <a href="/assets/band_logo.png" target="_blank" class="btn btn-secondary btn-sm">Preview</a>
              <a href="/assets/band_logo.png" download="possum_creek_pickers_logo.png" class="btn btn-primary btn-sm">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                Download Logo
              </a>
            </div>
          </div>
        </div>

        <!-- Landscape Band Photo Card -->
        <div class="glass-card asset-card">
          <div class="asset-preview photo-preview">
            <img src="/assets/band_photo_2026_landscape.JPG" alt="Possum Creek Pickers Band Photo (Landscape)" class="asset-img-photo" />
          </div>
          <div class="asset-details">
            <h3 class="asset-name">Band Publicity Photo (Landscape)</h3>
            <p class="asset-meta">JPG Format • High Resolution • Horizontal Layout</p>
            <div class="asset-actions">
              <a href="/assets/band_photo_2026_landscape.JPG" target="_blank" class="btn btn-secondary btn-sm">Preview</a>
              <a href="/assets/band_photo_2026_landscape.JPG" download="possum_creek_pickers_landscape.JPG" class="btn btn-primary btn-sm">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                Download Landscape
              </a>
            </div>
          </div>
        </div>

        <!-- Portrait Band Photo Card -->
        <div class="glass-card asset-card">
          <div class="asset-preview photo-preview">
            <img src="/assets/band_photo_2026_portrait.JPG" alt="Possum Creek Pickers Band Photo (Portrait)" class="asset-img-photo asset-img-portrait" />
          </div>
          <div class="asset-details">
            <h3 class="asset-name">Band Publicity Photo (Portrait)</h3>
            <p class="asset-meta">JPG Format • High Resolution • Vertical Layout</p>
            <div class="asset-actions">
              <a href="/assets/band_photo_2026_portrait.JPG" target="_blank" class="btn btn-secondary btn-sm">Preview</a>
              <a href="/assets/band_photo_2026_portrait.JPG" download="possum_creek_pickers_portrait.JPG" class="btn btn-primary btn-sm">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                Download Portrait
              </a>
            </div>
          </div>
        </div>

        <!-- Live Stage Photo Asset Card -->
        <div class="glass-card asset-card">
          <div class="asset-preview photo-preview">
            <img src="/assets/band_live.JPEG" alt="Possum Creek Pickers Live Stage Performance" class="asset-img-photo" />
          </div>
          <div class="asset-details">
            <h3 class="asset-name">Live Stage Performance Photo</h3>
            <p class="asset-meta">JPEG Format • Stage Lighting & Performance Photography</p>
            <div class="asset-actions">
              <a href="/assets/band_live.JPEG" target="_blank" class="btn btn-secondary btn-sm">Preview</a>
              <a href="/assets/band_live.JPEG" download="possum_creek_pickers_live.JPEG" class="btn btn-primary btn-sm">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                Download Live Photo
              </a>
            </div>
          </div>
        </div>

        <!-- Stage Plot Asset Card -->
        <div class="glass-card asset-card">
          <div class="asset-preview photo-preview">
            <img src="/assets/possum_creek_stage_plot.png" alt="Possum Creek Pickers Stage Plot" class="asset-img-photo" />
          </div>
          <div class="asset-details">
            <h3 class="asset-name">Official Stage Plot & Tech Rider</h3>
            <p class="asset-meta">PNG Format • Direct Link for Festival & Venue Forms</p>
            <div class="asset-actions">
              <a href="/stage-plot" class="btn btn-secondary btn-sm">View Page</a>
              <a href="/assets/possum_creek_stage_plot.png" target="_blank" download="possum_creek_stage_plot.png" class="btn btn-primary btn-sm">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                Download Stage Plot
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- YOUTUBE VIDEO SHOWCASE -->
  <YouTubeGallery />

  <!-- TECH RIDER & STAGE PLOT SUMMARY -->
  <section class="section tech-section" id="tech-rider">
    <div class="container">
      <div class="glass-card tech-card">
        <div class="tech-header">
          <span class="badge badge-amber">Venue & Sound Engineers</span>
          <h2 class="tech-title gradient-text">Stage Plot & Technical Rider</h2>
          <p class="tech-desc">Quick reference line-up inputs for venue sound technicians.</p>
          <div style="margin-top: 1rem; display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <a href="/stage-plot" class="btn btn-primary btn-sm">Direct Web Page Link (/stage-plot)</a>
            <a href="/assets/possum_creek_stage_plot.png" target="_blank" class="btn btn-secondary btn-sm">Direct Image Link (.png)</a>
          </div>
        </div>

        <div class="tech-grid">
          <div class="rider-box">
            <h4>Inputs & Vocal Channels</h4>
            <ul class="rider-list">
              <li>
                <span class="ch-num">CH 1</span>
                <div>
                  <strong>Elliott Brown — Lead Vocal</strong>
                  <p>Standard Vocal Mic (Shure SM58 or equivalent)</p>
                </div>
              </li>
              <li>
                <span class="ch-num">CH 2</span>
                <div>
                  <strong>Elliott Brown — Acoustic Guitar</strong>
                  <p>Active DI Box or Instrument Mic</p>
                </div>
              </li>
              <li>
                <span class="ch-num">CH 3</span>
                <div>
                  <strong>Micah Courey — Mandolin & Backup Vocal</strong>
                  <p>Instrument DI / Condenser Mic + Vocal Mic</p>
                </div>
              </li>
              <li>
                <span class="ch-num">CH 4</span>
                <div>
                  <strong>Kevin Taylor — Upright Bass & Backup Vocal</strong>
                  <p>Bass Pickup DI / Mic + Vocal Mic</p>
                </div>
              </li>
            </ul>
          </div>

          <div class="rider-box">
            <h4>Stage Setup & Requirements</h4>
            <div class="rider-info-content">
              <p><strong>Power:</strong> 1x standard 120V AC outlet on stage.</p>
              <p><strong>Monitors:</strong> 2 to 3 monitor mixes (Center vocal, Left mandolin, Right bass).</p>
              <p><strong>Setup Time:</strong> 15–20 minute soundcheck requirement.</p>
              <p><strong>Acoustic Environment:</strong> Suitable for both amplified PA stages and natural unamplified room acoustics.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- BOOKING & CONTACT -->
  <section class="section booking-section" id="booking">
    <div class="container">
      <div class="glass-card booking-card">
        <div class="booking-header text-center">
          <span class="badge badge-amber">Get In Touch</span>
          <h2 class="section-title gradient-text">Book Possum Creek Pickers</h2>
          <p class="section-subtitle">For festival inquiries, venue bookings, private parties, and press interviews.</p>
        </div>

        <div class="booking-contacts-grid">
          <div class="contact-card">
            <div class="contact-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </div>
            <h3>Email Booking</h3>
            <p>Direct inquiries to our management:</p>
            <a href="mailto:possumcreekpickers@gmail.com" class="contact-link">possumcreekpickers@gmail.com</a>
          </div>

          <div class="contact-card">
            <div class="contact-icon insta-icon-bg">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
            </div>
            <h3>Instagram DM</h3>
            <p>Connect with us on social media:</p>
            <a href="https://www.instagram.com/possumcreekpickers" target="_blank" rel="noopener noreferrer" class="contact-link">@possumcreekpickers</a>
          </div>

          <div class="contact-card">
            <div class="contact-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <h3>Location</h3>
            <p>Based in East Tennessee:</p>
            <span class="contact-text">Chattanooga, TN</span>
          </div>
  </section>
</Layout>

<style>
  /* EPK Hero */
  .epk-hero {
    padding-top: 3rem;
    padding-bottom: 2rem;
  }

  .epk-header-card {
    padding: 3rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    background: linear-gradient(135deg, rgba(255, 253, 248, 0.95), rgba(238, 233, 220, 0.9));
  }

  .epk-header-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .epk-main-title {
    font-size: 3.5rem;
    font-weight: 900;
    margin-top: 0.5rem;
    margin-bottom: 0.25rem;
    color: var(--text-main);
    padding-top: 8px;
  }

  .epk-tagline {
    font-size: 1.25rem;
    color: var(--text-muted);
  }

  .epk-quick-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-glass);
  }

  .stat-box {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .stat-label {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--forest-green);
    font-weight: 700;
  }

  .stat-value {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-main);
  }

  /* Bio Section */
  .bio-wrapper {
    padding: 3rem;
  }

  .bio-header {
    margin-bottom: 2rem;
  }

  .bio-content-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 3rem;
    align-items: flex-start;
  }

  .bio-subtitle {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--forest-green);
    margin-bottom: 1rem;
  }

  .bio-p {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 1.25rem;
  }

  .bio-p.lead {
    font-size: 1.15rem;
    color: var(--text-main);
  }

  .bio-p strong {
    color: var(--text-main);
  }

  .epk-photo-img {
    width: 100%;
    height: 240px;
    object-fit: cover;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
  }

  .photo-info {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .photo-title {
    font-weight: 700;
    color: var(--text-main);
    font-size: 0.95rem;
  }

  /* Roster */
  .roster-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 2.5rem;
  }

  /* Assets Section */
  .assets-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: 2rem;
    margin-top: 2.5rem;
  }

  .asset-card {
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .asset-preview {
    height: 220px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    background: rgba(238, 233, 220, 0.6);
    border-bottom: 1px solid var(--border-glass);
  }

  .asset-img-logo {
    max-height: 140px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 4px 15px rgba(27, 67, 44, 0.2));
  }

  .asset-img-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  .asset-img-portrait {
    object-position: center 20%;
  }

  .asset-details {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .asset-name {
    font-size: 1.25rem;
    font-weight: 700;
  }

  .asset-meta {
    color: var(--text-muted);
    font-size: 0.875rem;
    margin-bottom: 0.5rem;
  }

  .asset-actions {
    display: flex;
    gap: 0.75rem;
  }

  /* Tech Rider */
  .tech-card {
    padding: 3rem;
  }

  .tech-header {
    margin-bottom: 2rem;
  }

  .tech-title {
    font-size: 2rem;
    font-weight: 800;
    padding-top: 8px;
  }

  .tech-desc {
    color: var(--text-muted);
    font-size: 1rem;
  }

  .tech-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 2.5rem;
  }

  .rider-box {
    background: rgba(27, 67, 44, 0.04);
    border: 1px solid rgba(27, 67, 44, 0.12);
    border-radius: var(--radius-md);
    padding: 1.75rem;
  }

  .rider-box h4 {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--forest-green);
    margin-bottom: 1.25rem;
    border-bottom: 1px solid rgba(27, 67, 44, 0.2);
    padding-bottom: 0.5rem;
  }

  .rider-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .rider-list li {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .ch-num {
    background: rgba(27, 67, 44, 0.12);
    color: var(--forest-green);
    font-weight: 800;
    font-size: 0.8rem;
    padding: 0.3rem 0.6rem;
    border-radius: 4px;
    white-space: nowrap;
  }

  .rider-list strong {
    color: var(--text-main);
    font-size: 0.95rem;
  }

  .rider-list p {
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .rider-info-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .rider-info-content strong {
    color: var(--forest-green);
  }

  /* Booking Section */
  .booking-card {
    padding: 3.5rem;
  }

  .booking-contacts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 3rem;
  }

  .contact-card {
    background: rgba(27, 67, 44, 0.04);
